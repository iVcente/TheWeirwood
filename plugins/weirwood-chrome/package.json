{
  "name": "weirwood-chrome",
  "version": "1.0.0",
  "description": "The top bar, the section-index page, and the marks all three page types share.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./components": {
      "import": "./components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "sideEffects": false,
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "weirwood-chrome",
    "displayName": "Weirwood Chrome",
    "description": "Top bar with the section it is reading, and the section-index page type.",
    "category": [
      "pageType",
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "WeirwoodHeader": {
        "displayName": "Weirwood Header",
        "description": "The bar: wordmark, current section, greensight. Nothing on the landing.",
        "defaultPosition": "header",
        "defaultPriority": 10
      }
    },
    "optionSchema": {
      "greensightLabel": {
        "type": "string"
      },
      "rootsHeading": {
        "type": "string"
      },
      "greensightHeading": {
        "type": "string"
      },
      "greensightSub": {
        "type": "string"
      }
    }
  }
}
